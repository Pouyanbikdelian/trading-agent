# Copy this file to `.env` and fill in. `.env` is gitignored.

# ---- Environment ----
# Either "research", "paper", or "live". Default is "research" — no broker calls.
TRADING_ENV=research

# ---- IBKR / IB Gateway connection ----
# Local TWS:         host=127.0.0.1  paper=7497 live=7496
# Local IB Gateway:  host=127.0.0.1  paper=4002 live=4001
# docker-compose:    host=ib-gateway paper=4002 live=4001  (set by compose, not here)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=17

# IBKR account login. Only needed inside docker-compose so the bundled
# IB Gateway can log in unattended. Local TWS reads these from its own UI.
IBKR_USERNAME=
IBKR_PASSWORD=
# 'paper' or 'live'. The IB Gateway image inside docker-compose reads this
# on boot; the trader container reads TRADING_ENV + ALLOW_LIVE_TRADING.
IBKR_TRADING_MODE=paper

# Hard guard: live trading must be explicitly enabled. Set to "true" ONLY when ready.
# The risk manager refuses to submit live orders unless this is true AND TRADING_ENV=live.
ALLOW_LIVE_TRADING=false

# ---------------------------------------------------------------------------
# LIVE DAY — the complete set of changes, in one place.
#
# Arming live is REPLACING the paper runner, not adding to it. Runners are
# separate compose profiles:
#     docker compose --profile paper stop trader
#     docker compose --profile live up -d
# (Two runners would need two gateways, and two gateways cannot share host
# networking — the second Xvfb collides with the first's X display socket.)
#
#   TRADING_ENV=live
#   ALLOW_LIVE_TRADING=true
#   IBKR_TRADING_MODE=live
#   IBKR_PORT=4001                 # 4002 = paper. The gateway healthcheck
#                                  # follows this too.
#   IBKR_USERNAME=<paper username WITHOUT the trailing "2">
#
#   STATE_DIR=/app/state/live
#     ^ NOT optional. runner.db holds the daily-equity baseline the kill
#       switch computes from; mixing ~1.07M CHF paper snapshots with ~88k
#       live ones makes that number meaningless, so the daily-loss stop
#       would either fire instantly or never. Setting it HERE (rather than
#       in the compose service) means the bot and dashboard move with the
#       runner — otherwise /halt would write halt.json somewhere the live
#       runner never reads, and the kill switch would not stop live trading.
#
#   Sized-down first month — these are FRACTIONS OF TOTAL EQUITY, so they
#   move if you add or withdraw funds. For a ~10k sleeve on an ~88k account:
#   MAX_GROSS_EXPOSURE=0.11        # ≈ 9.7k deployed
#   MAX_POSITION_PCT=0.015         # ≈ 1.3k per name
#   MAX_DAILY_LOSS_PCT=0.006       # halts ≈ -530 (≈5% of the sleeve)
#   MAX_DRAWDOWN_PCT=0.02          # halts ≈ -1.8k (≈18% of the sleeve)
#     ^ the kill-switch percentages matter as much as the exposure ones:
#       at the 0.02 default the daily stop would not fire until -1,765,
#       which is 18% of a 10k sleeve and effectively never.
#   MAX_MARGIN_BORROWING_PCT=0.0   # cash-account behaviour
#   REQUIRE_CYCLE_APPROVAL=true    # you approve every batch by hand
#
# A plain `docker compose restart` does NOT re-read this file — use
# `docker compose up -d --force-recreate`.
# ---------------------------------------------------------------------------

# ---- Data sources (all optional; yfinance + ccxt are free) ----
# Tiingo (paid intraday data, $10/mo) — leave empty to skip.
TIINGO_API_KEY=

# Polygon (paid intraday data) — leave empty to skip.
POLYGON_API_KEY=

# ---- LLM agent committee (optional; advisory only) ----
# Enable the daily multi-agent committee (docs/concept_multiagent_memory.md).
# Requires ONE of the API keys below. Costs ~$5-30/mo depending on model.
AGENTS_ENABLED=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Model override (default: a mid-tier model per provider)
AGENTS_MODEL=

# Hard USD cap for the agent-PM sleeve when (and only when) it is bridged
# into the real order path — see docs/GO_LIVE.md §4. The simulated book
# ignores it. The bridge must treat this as the sleeve's total capital.
PM_SLEEVE_CAPITAL_USD=20000

# ---- Investment Committee Copilot (read-only /ask /why /thesis) ----
# LLM provider for the Telegram copilot. Default 'anthropic' uses the
# cheap Haiku model via ANTHROPIC_API_KEY above (already set for agents).
# Alternatives: 'qwen' (Alibaba Model Studio, needs DASHSCOPE_API_KEY) or
# 'deepseek' (needs DEEPSEEK_API_KEY). Model/endpoint overridable without
# code changes. The copilot can never place, modify or cancel orders.
COPILOT_PROVIDER=anthropic
# COPILOT_MODEL=
# COPILOT_BASE_URL=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=

# ---- Read-only LIVE-account mirror (docker compose --profile mirror) ----
# Live login (the paper username without its trailing "2"); password is
# IBKR_PASSWORD, shared with the paper login. The mirror gateway boots
# with READ_ONLY_API=yes — it can never trade. Check RAM before enabling.
IBKR_LIVE_USERNAME=

# ---- Committee cadence & Sentinel (optional; defaults shown) ----
# The committee is EXPENSIVE (multi-voice LLM debate). It convenes from
# exactly three places and nowhere else: the schedule below, the late-day
# de-risk trigger below, and manual /committee. Times are NYSE
# (America/New_York) so they track the US session across DST.
#
# Scheduled committee: twice weekly, mid-session (default Mon & Fri 13:00 ET).
# AGENTS_COMMITTEE_CRON=0 13 * * MON,FRI
#
# Late-day de-risk: one check ~50 min before the close (default 15:10 ET). If
# a held name is down >= SENTINEL_DERISK_DROP_PCT on the day by then, the
# committee convenes ONCE. The noisy open is excluded; nothing fires post-close.
# SENTINEL_DERISK_CRON=10 15 * * MON-FRI
# SENTINEL_DERISK_DROP_PCT=10.0
#
# The intraday Sentinel is INFORMATION ONLY (never convenes the committee):
# it sends a caution ping at most every ALERT_DEBOUNCE_HOURS while the tripped
# set is unchanged; a new/worse name pings immediately (ESCALATION_STEP_PCT).
# SENTINEL_ALERT_DEBOUNCE_HOURS=2.0
# SENTINEL_ESCALATION_STEP_PCT=3.0

# ---- Dashboard (optional) ----
# Web dashboard at http://<vps>:8787 — REQUIRED password (basic auth).
DASHBOARD_USER=yan
DASHBOARD_PASS=

# ---- Notifications (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Storage ----
DATA_DIR=./data/parquet
LOG_DIR=./logs
# NEVER point this at the live directory while the gateway is still in
# paper mode. A paper cycle writing here stamps paper equity into the
# live kill-switch baseline, and start_of_day will not re-take it — this
# is what halted the first live session at -91.82% (2026-08-07, see
# docs/incidents.md). The directory is stamped with the TRADING_ENV that
# wrote it (state/env.json) and a mismatched runner now refuses to
# start; check with `trading state check`.
STATE_DIR=./state

# ---- Risk limits (used by the risk manager; can also be overridden in config/risk.yaml) ----
MAX_GROSS_EXPOSURE=1.0       # 1.0 = 100% of equity, no leverage
MAX_POSITION_PCT=0.10        # any single name capped at 10% of equity
MAX_DAILY_LOSS_PCT=0.02      # daily loss > 2% triggers kill switch for the day
MAX_DRAWDOWN_PCT=0.15        # 15% peak-to-trough drawdown halts the system
# Margin policy. 0.0 = cash-account behavior: any order that would push
# a currency cash balance below zero is rejected pre-submit. For a CHF
# base account buying USD stocks, this means you must FX-convert into
# USD first (use /fx 100000 CHF to USD). Set to e.g. 0.50 if you want
# to permit up to 50% of equity in margin debt. LIVE-RECOMMENDED: 0.0.
MAX_MARGIN_BORROWING_PCT=0.0
# A stored daily-open baseline this far from actual equity is not a loss
# — it belongs to another account, another currency, or to before a
# deposit. Above this the manager re-stamps the baseline (daily open AND
# high-water mark) and alerts, instead of halting on a number the market
# could not have produced. 0.5 = 50%: generous on purpose, so it can only
# catch the absurd and never second-guesses a real drawdown.
BASELINE_SANITY_DIVERGENCE_PCT=0.5

# ---- Position guards (ATR trailing stops + profit ratchet) ----
# READ THIS ONE. The guards apply to EVERY position in the account, not
# just the ones the system opened. On 2026-08-07 they sold 63 shares of a
# personal VST holding seven minutes into the first live session, because
# nothing had ever made them visible — on paper they had only ever seen
# system positions.
#
# `false` disables the trailing stops. It does NOT protect a personal
# holding from the rebalance, which sells anything with a zero target
# weight. `/hold SYMBOL` is the only thing that blocks both paths.
GUARDS_ENABLED=false
# Stop distance = GUARD_ATR_MULT x the symbol's own recent volatility,
# clamped to [MIN, MAX] so neither a vol spike nor a sleepy tape produces
# a stop that is trivially hunted.
GUARD_ATR_MULT=3.0
GUARD_TRAIL_MIN_PCT=8
GUARD_TRAIL_MAX_PCT=20
# Refuse to act when the quoted price disagrees with the broker's own
# mark by more than this. yfinance occasionally serves an unadjusted
# price across a split; a naive comparison reads that as a 50% crash and
# answers with a full-position market sell.
GUARD_PRICE_SANITY_PCT=20

# ---- Who trades: the two sleeves ----
# INDEPENDENT knobs, each the fraction of the account that book directs.
# Deriving one from the other conflates two different meanings — see
# core/config.py. They do not have to sum to 1.
#   pm 0.00, strat 1.00 -> mechanical only (the default)
#   pm 0.11, strat 0.00 -> PM manages ~11%, strategy is benchmark-only
AGENT_PM_SLEEVE_PCT=0.0
STRATEGY_SLEEVE_PCT=1.0
# Hard DOLLAR ceiling on the PM sleeve, independent of the fraction
# above. A fraction alone lets the allocation grow with the account;
# this is what stops that. 0 disables.
PM_SLEEVE_CAPITAL_USD=20000
# How stale a PM decision may be and still execute. The PM is scheduled
# shortly before the cycle; anything near this limit means the two
# schedules have drifted and the decision no longer describes the tape it
# would trade against.
AGENT_PM_SIGNAL_MAX_AGE_H=6

# ---- Cycle approval workflow ----
# When true, every cycle pauses after computing the basket and asks the
# operator via Telegram before submitting orders. Operator replies with
# /approve, /approve <N>, /approve flat, or /reject. Default off for
# research/paper; flip on for live. The cycle times out and auto-rejects
# after CYCLE_APPROVAL_TIMEOUT_S seconds if no reply arrives.
REQUIRE_CYCLE_APPROVAL=false
CYCLE_APPROVAL_TIMEOUT_S=600

# ---- Defensive (reduce-only) cycles while halted ----
# A daily-loss or drawdown halt blocks new exposure. With this true (the
# default) a /cycle run while halted still builds the real CHF basket,
# strips it down to the orders that provably reduce an existing position
# (sells against longs, buy-backs against shorts, never past flat), and
# asks you to approve it. Buys and new names can never survive the filter,
# approval is mandatory here regardless of REQUIRE_CYCLE_APPROVAL, and the
# check is repeated against a fresh broker snapshot immediately before
# submission. Set false to make a halt a full information blackout again.
ALLOW_DEFENSIVE_CYCLE_WHEN_HALTED=true

# ---- docker-compose runner defaults (only read by docker-compose.yml) ----
# Local CLI uses --strategy / --cron flags; these only matter inside a
# container that launches its own `trading paper run` from compose.
UNIVERSE=sp500
STRATEGY=top_k_momentum
# Default: 4:05pm ET on Friday (after-close, weekly) for quarterly-rebalance
# strategies. Adjust to your strategy's natural cadence.
CRON=5 21 * * FRI
# Time zone for CRON only. Keep this separate from TZ, which also configures
# the IB Gateway's own session clock.
SCHEDULE_TZ=UTC
TZ=UTC

# How far before the scheduled cycle the Agent PM runs. This must leave
# enough room to complete the committee/PM decision before the cycle.
PM_PRE_CYCLE_LEAD_MINUTES=45

# Host's docker group GID — the trader needs this to write to
# /var/run/docker.sock and restart the ib-gateway container when the
# broker session goes dead. Find yours with:
#   stat -c %g /var/run/docker.sock
# Defaults to 999 (Debian). Ubuntu is usually 998. Set explicitly if
# yours differs, otherwise the self-heal will EACCES on the socket.
DOCKER_GID=999
